# Weather Mood environment variables
# Copy to .env.local for development. Never commit real values.

# Anthropic API key for the director (poem and visual profile) and the critic
# https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Claude models, overridable without a code change. Both default to
# claude-sonnet-5-5. Any override must support structured outputs and the
# effort setting (Claude Haiku 4.5 does not; claude-haiku-5-5 does).
#   director: writes the poem and designs the visual, voice and score
#   critic:   scores a screenshot of the canvas and proposes a revision
WEATHER_MOOD_DIRECTOR_MODEL=claude-sonnet-5-5
WEATHER_MOOD_CRITIC_MODEL=claude-sonnet-5-5

# ElevenLabs API key for narration, music and ambience
# https://elevenlabs.io/  (music generation needs a paid plan)
ELEVENLABS_API_KEY=

# Secret used to sign visit tokens. The music, sfx, narrate and critique routes
# refuse requests without a valid token, so one mood generation buys at most
# one call to each audio route and three critique rounds. Required in
# production (at least 16 characters); a built-in development secret is used
# when NODE_ENV is not production.
#   openssl rand -base64 32
VISIT_TOKEN_SECRET=

# Daily spend cap across all paid routes, in US cents (default 1000 = $10).
WEATHER_MOOD_DAILY_CAP_CENTS=1000

# Upstash Redis (REST) for shared rate limits, single-use grants, critique
# rounds and the spend cap across serverless instances. Optional, but without it every limit is
# per instance only. Vercel KV names (KV_REST_API_URL / KV_REST_API_TOKEN)
# are also accepted.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
