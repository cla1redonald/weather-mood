# Weather Mood environment variables
# Copy to .env.local for development. Never commit real values.

# Anthropic API key for poem and visual profile generation
# https://console.anthropic.com/
ANTHROPIC_API_KEY=

# ElevenLabs API key for narration, music and ambience
# https://elevenlabs.io/  (music generation needs a paid plan)
ELEVENLABS_API_KEY=

# Secret used to sign visit tokens. The music, sfx and narrate routes refuse
# requests without a valid token, so one mood generation buys at most one of
# each. Required in production (at least 16 characters); a built-in
# development secret is used when NODE_ENV is not production.
#   openssl rand -base64 32
VISIT_TOKEN_SECRET=

# Daily spend cap across all paid routes, in US cents (default 1000 = $10).
WEATHER_MOOD_DAILY_CAP_CENTS=1000

# Upstash Redis (REST) for shared rate limits, single-use grants and the spend
# cap across serverless instances. Optional, but without it every limit is
# per instance only. Vercel KV names (KV_REST_API_URL / KV_REST_API_TOKEN)
# are also accepted.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
